  "roles": [
    {
      "name": "copywriter",
      "description": "Especialista en texto corto publicable. Usar antes de redactar hooks en pantalla, títulos, captions, bios, textos de anuncio o de landing.",
      "skills": [
        "hooks",
        "humanizer",
        "idea",
        "simple"
      ]
    },
    {
      "name": "creative-director",
      "description": "Guardián de la marca del usuario. Usar antes de cualquier pieza creativa (imagen, video, copy, diseño, motion) para verificar que exista un manual de marca y que la pieza lo cumpla.",
      "skills": [
        "brand-onboarding",
        "carousel-news"
      ]
    },
    {
      "name": "dp-cinematographer",
      "description": "Diseño de la imagen. Usar antes de generar o buscar cualquier imagen o video: shot lists, planificación de B-roll, storyboards, dirección de arte y prompts visuales por escena.",
      "skills": [
        "broll-plan",
        "reference-clone"
      ]
    },
    {
      "name": "editor-video",
      "description": "Armado y mezcla de video. Usar antes de cortar, poner capas, subtítulos, música o exportar: convierte material aprobado en una pieza terminada y revisada.",
      "skills": [
        "captions"
      ]
    },
    {
      "name": "fact-checker",
      "description": "Revisión de hechos, separada de la marca. Usar antes de publicar cualquier pieza con cifras, nombres propios, fechas o afirmaciones verificables.",
      "skills": [
        "deep-research"
      ]
    },
    {
      "name": "motion-designer",
      "description": "Motion graphics en After Effects. Usar para clonar el estilo de una referencia, armar títulos, overlays, transiciones o piezas completas y entregar un proyecto editable. Se instala solo con el módulo de After Effects.",
      "skills": []
    },
    {
      "name": "screenwriter",
      "description": "Arquitecto de guiones. Usar antes de escribir cualquier guion de video (corto o largo): hook de los primeros segundos, arco hook → tensión → cierre, estructura y locución.",
      "skills": [
        "story-plan"
      ]
    },
    {
      "name": "social-media-manager",
      "description": "Distribución y lectura de resultados. Usar para armar calendarios, adaptar una pieza a cada red, programar publicaciones y leer métricas o competidores.",
      "skills": []
    },
    {
      "name": "strategist",
      "description": "Socio de pensamiento estratégico. Usar para elegir temas y ángulos, investigar audiencia, evaluar una idea nueva o un cambio de rumbo, y decidir qué conviene producir antes de escribir nada.",
      "skills": [
        "onboard",
        "trend-research",
        "web-research",
        "kickoff-lite",
        "wiki",
        "task",
        "task-checkpoint",
        "finish-session"
      ]
    }
  ]
