{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "catalog.schema.json",
  "title": "Kit catalog",
  "description": "Validated by tools/guard.py with a stdlib subset validator. Supported keywords: type, properties, required, additionalProperties, items, enum, const, pattern, minItems, minLength, uniqueItems, $ref (#/$defs only).",
  "type": "object",
  "required": ["version", "skills", "roles"],
  "additionalProperties": false,
  "properties": {
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "skills": {"type": "array", "items": {"$ref": "#/$defs/skill"}},
    "roles": {"type": "array", "items": {"$ref": "#/$defs/role"}}
  },
  "$defs": {
    "name": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
    "strings": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "skill": {
      "type": "object",
      "required": ["name", "category", "tier", "status", "role", "deps", "paid_services", "network", "support", "smoke", "files"],
      "additionalProperties": false,
      "properties": {
        "name": {"$ref": "#/$defs/name"},
        "category": {"type": "string", "minLength": 1},
        "tier": {"enum": ["core", "module"]},
        "status": {"enum": ["tested", "untested"]},
        "role": {"$ref": "#/$defs/name"},
        "deps": {"$ref": "#/$defs/strings"},
        "paid_services": {"$ref": "#/$defs/strings"},
        "network": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["service", "data"],
            "additionalProperties": false,
            "properties": {
              "service": {"type": "string", "minLength": 1},
              "data": {"type": "string", "minLength": 1}
            }
          }
        },
        "support": {
          "type": "object",
          "required": ["claude", "codex", "windows", "mac"],
          "additionalProperties": false,
          "properties": {
            "claude": {"type": "boolean"},
            "codex": {"type": "boolean"},
            "windows": {"type": "boolean"},
            "mac": {"type": "boolean"}
          }
        },
        "smoke": {
          "type": "object",
          "required": ["argv"],
          "additionalProperties": false,
          "properties": {
            "argv": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
          }
        },
        "files": {"$ref": "#/$defs/strings"}
      }
    },
    "role": {
      "type": "object",
      "required": ["name", "skills"],
      "additionalProperties": false,
      "properties": {
        "name": {"$ref": "#/$defs/name"},
        "description": {"type": "string"},
        "skills": {"type": "array", "items": {"$ref": "#/$defs/name"}, "uniqueItems": true}
      }
    }
  }
}
